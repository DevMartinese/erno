{
  "name": "erno",
  "version": "0.1.0",
  "description": "A tiny engine for twisty puzzles rendered to SVG — N×N cubes, Skewb, Pyraminx, Mirror and Void",
  "type": "module",
  "main": "./dist/erno.umd.cjs",
  "module": "./dist/erno.js",
  "exports": {
    ".": {
      "import": "./dist/erno.js",
      "require": "./dist/erno.umd.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite site --host",
    "build": "vite build",
    "build:site": "vite build --config site/vite.config.js",
    "preview": "vite preview site",
    "test": "node tests/erno.test.js && node tests/twisty.test.js"
  },
  "keywords": [
    "rubik",
    "cube",
    "svg",
    "3d",
    "isometric",
    "puzzle",
    "speedcubing",
    "visualization",
    "skewb",
    "pyraminx",
    "mirror-cube",
    "void-cube",
    "twisty-puzzle"
  ],
  "author": "DevMartinese",
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.0.1"
  }
}
